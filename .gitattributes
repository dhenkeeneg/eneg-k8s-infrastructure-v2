# Git Line Ending Normalization
# Ensures consistent line endings across Windows, Mac, and Linux

# Default: normalize all text files to LF in the repository
* text=auto eol=lf

# Explicitly define text files
*.md        text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.tf        text eol=lf
*.hcl       text eol=lf
*.sh        text eol=lf
*.py        text eol=lf
*.json      text eol=lf
*.toml      text eol=lf
*.ini       text eol=lf
*.cfg       text eol=lf
*.txt       text eol=lf
*.env       text eol=lf

# Shell scripts must always use LF (would break on Linux/Mac with CRLF)
*.sh        text eol=lf

# Windows batch files use CRLF
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# Binary files - no line ending conversion
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.zip       binary
*.tar.gz    binary
*.tgz       binary
*.gz        binary
*.pfx       binary
*.p12       binary
