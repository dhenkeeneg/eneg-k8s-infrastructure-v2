---
# VORLAGE - NICHT COMMITTEN!
# Diese Datei auf dem Management-Server (k8s-mgmt-10) bearbeiten:
#
# Werte generieren:
#   SECRET_KEY_BASE:   openssl rand -hex 64
#   HOCUSPOCUS_SECRET: openssl rand -hex 32
#   DB_PASSWORT:       Dasselbe Passwort wie in openproject-db-credentials (databases NS)
#   S3_ACCESS_KEY:     Garage Key ID fuer openproject-app
#   S3_SECRET_KEY:     Garage Secret Key fuer openproject-app
#
# DATABASE_URL Format: postgres://openproject:PASSWORT@cnpg-erp-rw.databases.svc.cluster.local:5432/openproject
#
# Verschluesseln:
#   cd ~/git/eneg-k8s-infrastructure-v2/kubernetes/base/apps/openproject/secrets
#   sops --encrypt --age age1fdqtcha9jnzqafe5t6hed6v5sv858x2tt6nwuw00u3luyxuaqcxqh5mcrm \
#        --encrypted-regex '^(data|stringData)$' \
#        openproject-secrets.yaml > openproject-secrets.enc.yaml
#
# Diese Vorlage loeschen, nur .enc.yaml committen
apiVersion: v1
kind: Secret
metadata:
  name: openproject-secrets
  namespace: openproject
  labels:
    app.kubernetes.io/name: openproject
    app.kubernetes.io/managed-by: argocd
type: Opaque
stringData:
  secret-key-base: "HIER_GENERIERTEN_SECRET_KEY_BASE_EINTRAGEN"
  hocuspocus-secret: "HIER_GENERIERTEN_HOCUSPOCUS_SECRET_EINTRAGEN"
  database-url: "postgres://openproject:HIER_DB_PASSWORT@cnpg-erp-rw.databases.svc.cluster.local:5432/openproject"
  s3-access-key-id: "GK50841c65af761abbb7f9126c"
  s3-secret-access-key: "HIER_GARAGE_SECRET_KEY_EINTRAGEN"
