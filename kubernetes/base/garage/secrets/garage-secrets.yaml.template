---
# VORLAGE - NICHT COMMITTEN!
# Diese Datei auf dem Management-Server (k8s-mgmt-10) bearbeiten:
#
# 1. Secrets generieren:
#      RPC_SECRET=$(openssl rand -hex 32)
#      ADMIN_TOKEN=$(openssl rand -hex 32)
#      METRICS_TOKEN=$(openssl rand -hex 32)
#
# 2. WebUI Auth generieren (apache2-utils muss installiert sein):
#      sudo apt-get install -y apache2-utils
#      htpasswd -nbBC 10 'admin' 'DEIN_SICHERES_PASSWORT'
#    Ausgabe ist im Format: admin:$2y$10$...
#    Diesen kompletten String unten bei webui-auth eintragen
#
# 3. Werte unten eintragen
#
# 4. Verschluesseln:
#      cd ~/git/eneg-k8s-infrastructure-v2/kubernetes/base/garage/secrets
#      sops --encrypt --age age1fdqtcha9jnzqafe5t6hed6v5sv858x2tt6nwuw00u3luyxuaqcxqh5mcrm \
#           --encrypted-regex '^(data|stringData)$' \
#           garage-secrets.yaml > garage-secrets.enc.yaml
#
# 5. Diese Vorlage loeschen, nur .enc.yaml committen
apiVersion: v1
kind: Secret
metadata:
  name: garage-secrets
  namespace: garage
  labels:
    app.kubernetes.io/name: garage
    app.kubernetes.io/part-of: infrastructure
    app.kubernetes.io/managed-by: argocd
type: Opaque
stringData:
  rpc-secret: "HIER_RPC_SECRET_EINTRAGEN"
  admin-token: "HIER_ADMIN_TOKEN_EINTRAGEN"
  metrics-token: "HIER_METRICS_TOKEN_EINTRAGEN"
  webui-auth: "admin:HIER_BCRYPT_HASH_EINTRAGEN"
