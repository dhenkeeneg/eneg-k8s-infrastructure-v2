---
# VORLAGE - NICHT COMMITTEN!
# PROD-Umgebung: MariaDB Root + S3-Credentials
# WICHTIG (P4b): mariadb-credentials wird AUCH von mariadb-galera.yaml genutzt
# (rootPasswordSecretKeyRef -> ROOT_PASSWORD). Beim Neuverschluesseln daher die
# bestehende .enc.yaml entschluesseln und NUR die S3-Felder auf NAS20 aendern -
# ROOT_PASSWORD UNVERAENDERT lassen (sonst verliert der Galera-Operator Zugang)!
#
# QuObjects Access-Key-Format (NAS20): S3_ACCESS_KEY_ID ist der KOMBINIERTE Wert
# <user>:<token> (z.B. "s3-prod:ABC123..."). S3_SECRET_ACCESS_KEY ist ein
# SEPARATER Wert. NICHT am ":" aufteilen! Wertequelle: funktionierendes
# Loki/Thanos-Secret desselben NAS20-Accounts.
#
# Auf k8s-mgmt-10 (truncation-sicher, siehe SOPS-Prozedur):
#   cd ~/git/eneg-k8s-infrastructure-v2/kubernetes/environments/prod/mariadb-secrets
#   sops --decrypt mariadb-credentials.enc.yaml > mariadb-credentials.tmp.yaml
#   nano mariadb-credentials.tmp.yaml   # nur S3-Felder auf NAS20, ROOT_PASSWORD unveraendert
#   sops --encrypt --age age1fdqtcha9jnzqafe5t6hed6v5sv858x2tt6nwuw00u3luyxuaqcxqh5mcrm \
#        --encrypted-regex '^(data|stringData)$' \
#        mariadb-credentials.tmp.yaml > mariadb-credentials.enc.new
#   mv mariadb-credentials.enc.new mariadb-credentials.enc.yaml
#   rm mariadb-credentials.tmp.yaml
apiVersion: v1
kind: Secret
metadata:
  name: mariadb-credentials
  namespace: databases
  labels:
    app.kubernetes.io/part-of: mariadb-galera
    app.kubernetes.io/managed-by: argocd
type: Opaque
stringData:
  # MariaDB Root-Passwort - UNVERAENDERT aus bestehender .enc.yaml uebernehmen!
  ROOT_PASSWORD: "UNVERAENDERT_LASSEN"
  # S3-Backup-Credentials (PROD-Account auf NAS20, P4b)
  # ACCESS_KEY_ID = kombiniert <user>:<token>, SECRET separat
  S3_ACCESS_KEY_ID: "HIER_KOMBINIERT_user:token_EINTRAGEN"
  S3_SECRET_ACCESS_KEY: "HIER_NAS20_SECRET_KEY_EINTRAGEN"
  S3_ENDPOINT: "https://nas20.eneg.de:8010"
