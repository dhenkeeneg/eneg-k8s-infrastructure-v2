---
# VORLAGE - NICHT COMMITTEN!
# PROD-Umgebung: MariaDB Root + S3-Credentials
# Auf k8s-mgmt-10:
# 1. Root-Passwort generieren: openssl rand -hex 24
# 2. S3 SECRET_ACCESS_KEY eintragen (fuer PROD-Buckets auf NAS10)
# 3. Verschluesseln:
#      cd ~/git/eneg-k8s-infrastructure-v2/kubernetes/environments/prod/mariadb-secrets
#      sops --encrypt --age age1fdqtcha9jnzqafe5t6hed6v5sv858x2tt6nwuw00u3luyxuaqcxqh5mcrm \
#           --encrypted-regex '^(data|stringData)$' \
#           mariadb-credentials.yaml > mariadb-credentials.enc.yaml
#      rm mariadb-credentials.yaml
apiVersion: v1
kind: Secret
metadata:
  name: mariadb-credentials
  namespace: databases
  labels:
    app.kubernetes.io/part-of: mariadb-galera
    app.kubernetes.io/managed-by: argocd
type: Opaque
stringData:
  # MariaDB Root-Passwort
  ROOT_PASSWORD: "HIER_SICHERES_PASSWORT"
  # S3-Backup-Credentials (PROD-Account auf NAS10)
  S3_ACCESS_KEY_ID: "s3-k8s-prod"
  S3_SECRET_ACCESS_KEY: "HIER_SECRET_KEY_EINTRAGEN"
  S3_ENDPOINT: "http://nas10.eneg.de:8010"
