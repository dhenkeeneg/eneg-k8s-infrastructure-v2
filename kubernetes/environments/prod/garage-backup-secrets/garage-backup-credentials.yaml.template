---
# VORLAGE - NICHT COMMITTEN!
# PROD-Umgebung: Garage Backup Credentials
# Auf k8s-mgmt-10:
# 1. Context wechseln: kubectl config use-context k8s-prod
# 2. Garage Read-Only Key erstellen:
#      kubectl exec -n garage garage-0 -- /garage key create garage-backup-readonly
#      kubectl exec -n garage garage-0 -- /garage key info garage-backup-readonly
# 3. Read-Only Zugriff auf alle Buckets geben
# 4. NAS20 S3 Credentials eintragen (s3-k8s-prod Account, NAS20)
# 5. Verschluesseln:
#      cd ~/git/eneg-k8s-infrastructure-v2/kubernetes/environments/prod/garage-backup-secrets
#      cp garage-backup-credentials.yaml.template garage-backup-credentials.yaml
#      nano garage-backup-credentials.yaml  # Keys eintragen
#      sops --encrypt --age age1fdqtcha9jnzqafe5t6hed6v5sv858x2tt6nwuw00u3luyxuaqcxqh5mcrm \
#           --encrypted-regex '^(data|stringData)$' \
#           garage-backup-credentials.yaml > garage-backup-credentials.enc.yaml
#      rm garage-backup-credentials.yaml
apiVersion: v1
kind: Secret
metadata:
  name: garage-backup-credentials
  namespace: garage
  labels:
    app.kubernetes.io/name: garage-backup
    app.kubernetes.io/part-of: infrastructure
    app.kubernetes.io/managed-by: argocd
type: Opaque
stringData:
  GARAGE_ACCESS_KEY_ID: "HIER_GARAGE_KEY_ID"
  GARAGE_SECRET_ACCESS_KEY: "HIER_GARAGE_SECRET_KEY"
  # NAS20 S3 (Destination) - Account s3-k8s-prod (P4b NAS10->NAS20)
  # ACCESS_KEY_ID = kombiniert <user>:<token>, SECRET separat. NICHT am : trennen!
  # Wertequelle: funktionierendes NAS20-Secret desselben PROD-Accounts (z.B. mariadb).
  NAS_ACCESS_KEY_ID: "s3-k8s-prod:HIER_TOKEN"
  NAS_SECRET_ACCESS_KEY: "HIER_NAS20_SECRET_KEY"
