---
# VORLAGE - NICHT COMMITTEN!
# TEST-Umgebung: CNPG S3-Credentials (P4b NAS10->NAS20)
# WICHTIG: cnpg-s3-credentials wird GETEILT von beiden ObjectStores (erp+shared)
# UND beiden pg_dumpall-CronJobs. Aenderung wirkt sofort auf ALLE vier Nutzer.
# QuObjects-Format: ACCESS_KEY_ID = kombiniert "s3-k8s-test:<token>",
#                   SECRET_ACCESS_KEY = separater eigener Wert (NICHT am ":" trennen!)
# Auf k8s-mgmt-10 bearbeiten (bestehende .enc.yaml als Basis, Truncation-sicher):
#   cd ~/git/eneg-k8s-infrastructure-v2/kubernetes/environments/test/cnpg-secrets
#   sops --decrypt s3-credentials.enc.yaml > s3-credentials.tmp.yaml
#   nano s3-credentials.tmp.yaml   (ACCESS_KEY_ID/SECRET_ACCESS_KEY/S3_ENDPOINT auf NAS20)
#   sops --encrypt s3-credentials.tmp.yaml > s3-credentials.enc.new
#   mv s3-credentials.enc.new s3-credentials.enc.yaml && rm s3-credentials.tmp.yaml
apiVersion: v1
kind: Secret
metadata:
  name: cnpg-s3-credentials
  namespace: databases
  labels:
    app.kubernetes.io/part-of: cloudnative-pg
    app.kubernetes.io/managed-by: argocd
type: Opaque
stringData:
  # QuObjects-Format: kombinierter Access-Key (s3-k8s-test:<token>)
  ACCESS_KEY_ID: "s3-k8s-test:HIER_NAS20_TOKEN"
  SECRET_ACCESS_KEY: "HIER_NAS20_SECRET_KEY_EINTRAGEN"
  S3_ENDPOINT: "https://nas20.eneg.de:8010"
