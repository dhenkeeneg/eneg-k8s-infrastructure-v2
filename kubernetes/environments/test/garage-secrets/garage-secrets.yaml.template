---
# VORLAGE - NICHT COMMITTEN!
# TEST-Umgebung: Garage Secrets
# Auf k8s-mgmt-10:
# 1. Secrets generieren:
#      RPC_SECRET=$(openssl rand -hex 32)
#      ADMIN_TOKEN=$(openssl rand -hex 32)
#      METRICS_TOKEN=$(openssl rand -hex 32)
# 2. WebUI Auth:
#      htpasswd -nbBC 10 'admin' 'DEIN_PASSWORT'
# 3. Verschluesseln:
#      cd ~/git/eneg-k8s-infrastructure-v2/kubernetes/environments/test/garage-secrets
#      sops --encrypt --encrypted-regex '^(data|stringData)$' \
#           garage-secrets.yaml > garage-secrets.enc.yaml
#      rm garage-secrets.yaml
apiVersion: v1
kind: Secret
metadata:
  name: garage-secrets
  namespace: garage
  labels:
    app.kubernetes.io/name: garage
    app.kubernetes.io/part-of: infrastructure
    app.kubernetes.io/managed-by: argocd
type: Opaque
stringData:
  rpc-secret: "HIER_RPC_SECRET_EINTRAGEN"
  admin-token: "HIER_ADMIN_TOKEN_EINTRAGEN"
  metrics-token: "HIER_METRICS_TOKEN_EINTRAGEN"
  webui-auth: "admin:HIER_BCRYPT_HASH_EINTRAGEN"
