---
# VORLAGE - NICHT COMMITTEN!
# TEST-Umgebung: Garage Backup Credentials
# Auf k8s-mgmt-10:
# 1. Garage Read-Only Key erstellen (nach Garage-Deploy auf TEST):
#      kubectl --kubeconfig=kubeconfig-test.yaml exec -n garage garage-0 -- /garage key create garage-backup-readonly
#      kubectl --kubeconfig=kubeconfig-test.yaml exec -n garage garage-0 -- /garage key info garage-backup-readonly
# 2. Read-Only Zugriff auf alle Buckets geben
# 3. NAS20 S3 Credentials eintragen (s3-k8s-test Account, NAS20)
# 4. Verschluesseln:
#      cd ~/git/eneg-k8s-infrastructure-v2/kubernetes/environments/test/garage-backup-secrets
#      sops --encrypt --encrypted-regex '^(data|stringData)$' \
#           garage-backup-credentials.yaml > garage-backup-credentials.enc.yaml
#      rm garage-backup-credentials.yaml
apiVersion: v1
kind: Secret
metadata:
  name: garage-backup-credentials
  namespace: garage
  labels:
    app.kubernetes.io/name: garage-backup
    app.kubernetes.io/part-of: infrastructure
    app.kubernetes.io/managed-by: argocd
type: Opaque
stringData:
  GARAGE_ACCESS_KEY_ID: "HIER_GARAGE_KEY_ID"
  GARAGE_SECRET_ACCESS_KEY: "HIER_GARAGE_SECRET_KEY"
  # NAS20 S3 (Destination) - Account s3-k8s-test (P4b NAS10->NAS20)
  NAS_ACCESS_KEY_ID: "s3-k8s-test"
  NAS_SECRET_ACCESS_KEY: "HIER_NAS20_SECRET_KEY"
