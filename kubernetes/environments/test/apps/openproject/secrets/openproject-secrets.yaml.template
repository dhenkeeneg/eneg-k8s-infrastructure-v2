---
# VORLAGE - NICHT COMMITTEN!
# TEST-Umgebung: OpenProject Secrets
# Auf k8s-mgmt-10:
# 1. Werte generieren:
#      SECRET_KEY_BASE:   openssl rand -hex 64
#      HOCUSPOCUS_SECRET: openssl rand -hex 32
#      DB_PASSWORT:       Dasselbe wie in test/cnpg-secrets/openproject-db-credentials
#      S3_ACCESS_KEY:     Garage Key ID fuer openproject-app (TEST Garage)
#      S3_SECRET_KEY:     Garage Secret Key fuer openproject-app (TEST Garage)
# 2. DATABASE_URL: postgres://openproject:PASSWORT@cnpg-erp-rw.databases.svc.cluster.local:5432/openproject
# 3. Verschluesseln:
#      cd ~/git/eneg-k8s-infrastructure-v2/kubernetes/environments/test/apps/openproject/secrets
#      sops --encrypt --encrypted-regex '^(data|stringData)$' \
#           openproject-secrets.yaml > openproject-secrets.enc.yaml
#      rm openproject-secrets.yaml
apiVersion: v1
kind: Secret
metadata:
  name: openproject-secrets
  namespace: openproject
  labels:
    app.kubernetes.io/name: openproject
    app.kubernetes.io/managed-by: argocd
type: Opaque
stringData:
  secret-key-base: "HIER_GENERIERTEN_SECRET_KEY_BASE_EINTRAGEN"
  hocuspocus-secret: "HIER_GENERIERTEN_HOCUSPOCUS_SECRET_EINTRAGEN"
  database-url: "postgres://openproject:HIER_DB_PASSWORT@cnpg-erp-rw.databases.svc.cluster.local:5432/openproject"
  s3-access-key-id: "HIER_GARAGE_ACCESS_KEY_ID"
  s3-secret-access-key: "HIER_GARAGE_SECRET_KEY_EINTRAGEN"
  oidc-client-secret: "HIER_KEYCLOAK_CLIENT_SECRET_FUER_OPENPROJECT_EINTRAGEN"
