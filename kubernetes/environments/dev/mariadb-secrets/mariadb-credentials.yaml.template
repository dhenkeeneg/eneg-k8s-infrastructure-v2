type: Opaque
stringData:
  # MariaDB Root-Passwort
  ROOT_PASSWORD: "HIER_SICHERES_PASSWORT"
  # S3-Backup-Credentials (gleicher S3-Account wie CNPG)
  S3_ACCESS_KEY_ID: "s3-k8s-dev"
