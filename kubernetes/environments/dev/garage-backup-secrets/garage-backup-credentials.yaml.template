---
# VORLAGE - NICHT COMMITTEN!
# Diese Datei auf dem Management-Server (k8s-mgmt-10) bearbeiten:
#
# 1. Garage Read-Only Key erstellen:
#      kubectl exec -n garage garage-0 -- /garage key create garage-backup-readonly
#      kubectl exec -n garage garage-0 -- /garage key info garage-backup-readonly
#    -> Key ID (GK...) und Secret Key notieren
#
# 2. Read-Only Zugriff auf alle Buckets geben:
#      kubectl exec -n garage garage-0 -- /garage bucket allow <bucket> --read --key garage-backup-readonly
#    -> Fuer jeden Bucket wiederholen
#
# 3. NAS20 S3 Credentials: User k8s-dev-s3 (Speicherplatz s3-k8s-dev)
#
# 4. Werte unten eintragen
#
# 5. Verschluesseln:
#      cd ~/git/eneg-k8s-infrastructure-v2/kubernetes/base/garage/backup/secrets
#      sops --encrypt --age age1fdqtcha9jnzqafe5t6hed6v5sv858x2tt6nwuw00u3luyxuaqcxqh5mcrm \
#           --encrypted-regex '^(data|stringData)$' \
#           garage-backup-credentials.yaml > garage-backup-credentials.enc.yaml
#
# 6. Diese Vorlage loeschen, nur .enc.yaml committen
apiVersion: v1
kind: Secret
metadata:
  name: garage-backup-credentials
  namespace: garage
  labels:
    app.kubernetes.io/name: garage-backup
    app.kubernetes.io/part-of: infrastructure
    app.kubernetes.io/managed-by: argocd
type: Opaque
stringData:
  # Garage S3 (Source) - Read-Only Key
  GARAGE_ACCESS_KEY_ID: "HIER_GARAGE_KEY_ID_EINTRAGEN"
  GARAGE_SECRET_ACCESS_KEY: "HIER_GARAGE_SECRET_KEY_EINTRAGEN"
  # NAS20 S3 (Destination) - User k8s-dev-s3
  NAS_ACCESS_KEY_ID: "HIER_NAS20_ACCESS_KEY_EINTRAGEN"
  NAS_SECRET_ACCESS_KEY: "HIER_NAS20_SECRET_KEY_EINTRAGEN"
