---
# VORLAGE - NICHT MIT ECHTEN WERTEN COMMITTEN!
# Diese Datei auf dem Management-Server (k8s-mgmt-10) bearbeiten:
# 1. Schluessel mit dem Gitea-Binary generieren (siehe docs/runbooks):
#      gitea generate secret SECRET_KEY
#      gitea generate secret INTERNAL_TOKEN
#      gitea generate secret JWT_SECRET
# 2. db-password: dasselbe Passwort wie in gitea-db-credentials
#    (Namespace databases, environments/dev/cnpg-secrets/)
# 3. Verschluesseln:
#      cd ~/git/eneg-k8s-infrastructure-v2/kubernetes/environments/dev/apps/gitea/secrets
#      sops --encrypt --age age1fdqtcha9jnzqafe5t6hed6v5sv858x2tt6nwuw00u3luyxuaqcxqh5mcrm \
#           --encrypted-regex '^(data|stringData)$' \
#           gitea-secrets.yaml > gitea-secrets.enc.yaml
# 4. Klartext-Datei loeschen, nur .enc.yaml committen
apiVersion: v1
kind: Secret
metadata:
  name: gitea-secrets
  namespace: gitea
  labels:
    app.kubernetes.io/name: gitea
    app.kubernetes.io/managed-by: argocd
type: Opaque
stringData:
  secret-key: "HIER_SECRET_KEY_EINTRAGEN"
  internal-token: "HIER_INTERNAL_TOKEN_EINTRAGEN"
  jwt-secret: "HIER_JWT_SECRET_EINTRAGEN"
  db-password: "HIER_DASSELBE_DB_PASSWORT_WIE_IN_gitea-db-credentials"
