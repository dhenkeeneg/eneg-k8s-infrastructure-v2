---
# VORLAGE - NICHT COMMITTEN!
# Diese Datei auf dem Management-Server (k8s-mgmt-10) bearbeiten:
#
# NAS20 S3 Credentials: User k8s-dev-s3 (Speicherplatz s3-k8s-dev)
#
# 1. Werte unten eintragen
#
# 2. Verschluesseln:
#      cd ~/git/eneg-k8s-infrastructure-v2/kubernetes/base/apps/odoo/backup/secrets
#      sops --encrypt --age age1fdqtcha9jnzqafe5t6hed6v5sv858x2tt6nwuw00u3luyxuaqcxqh5mcrm \
#           --encrypted-regex '^(data|stringData)$' \
#           odoo-backup-credentials.yaml > odoo-backup-credentials.enc.yaml
#
# 3. Diese Vorlage loeschen, nur .enc.yaml committen
apiVersion: v1
kind: Secret
metadata:
  name: odoo-backup-credentials
  namespace: odoo
  labels:
    app.kubernetes.io/name: odoo-backup
    app.kubernetes.io/part-of: pilot-apps
    app.kubernetes.io/managed-by: argocd
type: Opaque
stringData:
  # NAS20 S3 (Destination) - User k8s-dev-s3
  NAS_ACCESS_KEY_ID: "HIER_NAS20_ACCESS_KEY_EINTRAGEN"
  NAS_SECRET_ACCESS_KEY: "HIER_NAS20_SECRET_KEY_EINTRAGEN"
