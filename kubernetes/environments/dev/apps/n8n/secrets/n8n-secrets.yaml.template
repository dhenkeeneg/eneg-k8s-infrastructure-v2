---
# VORLAGE - NICHT COMMITTEN!
# Diese Datei auf dem Management-Server (k8s-mgmt-10) bearbeiten:
# 1. Encryption Key generieren: openssl rand -hex 32
# 2. DB-Passwort: Dasselbe Passwort wie in n8n-db-credentials (databases Namespace)
# 3. Verschluesseln:
#      cd ~/git/eneg-k8s-infrastructure-v2/kubernetes/base/apps/n8n/secrets
#      sops --encrypt --age age1fdqtcha9jnzqafe5t6hed6v5sv858x2tt6nwuw00u3luyxuaqcxqh5mcrm \
#           --encrypted-regex '^(data|stringData)$' \
#           n8n-secrets.yaml > n8n-secrets.enc.yaml
# 4. Diese Vorlage loeschen, nur .enc.yaml committen
apiVersion: v1
kind: Secret
metadata:
  name: n8n-secrets
  namespace: n8n
  labels:
    app.kubernetes.io/name: n8n
    app.kubernetes.io/managed-by: argocd
type: Opaque
stringData:
  encryption-key: "HIER_GENERIERTEN_ENCRYPTION_KEY_EINTRAGEN"
  db-password: "HIER_DASSELBE_DB_PASSWORT_WIE_IN_n8n-db-credentials"
