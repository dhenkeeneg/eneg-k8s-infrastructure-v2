---
# VORLAGE - mit Platzhaltern committet, befuellte Plaintext-Kopie NICHT committen!
# Zot Registry Sync Credentials (DEV) - fuer Upstream Pull-Through-Cache
#
# Enthaelt Credentials fuer:
#   - ghcr.io   (eigene Images dhenkeeneg/*, Phase 9a Etappe A8)
#   - registry-1.docker.io (Rate-Limit-Umgehung durch Authentication,
#                           200 pulls/6h statt 60 anonymous)
#
# Phase 9a - Etappe A8 + A9 (DockerHub Auth hinzugefuegt nach Rate-Limit-Hit)
#
# Workflow auf k8s-mgmt-10:
#   cd ~/git/eneg-k8s-infrastructure-v2/kubernetes/environments/dev/registry-secrets
#   cp ghcr-sync-credentials.yaml.template ghcr-sync-credentials.yaml
#   nano ghcr-sync-credentials.yaml
#     -> ghcr.io 'password:' = bestehender GHCR PAT (gleicher wie ghcr-pull-secret)
#     -> registry-1.docker.io 'username:' = DockerHub-Username
#     -> registry-1.docker.io 'password:' = DockerHub Access Token (dckr_pat_...)
#   sops --encrypt --age age1fdqtcha9jnzqafe5t6hed6v5sv858x2tt6nwuw00u3luyxuaqcxqh5mcrm \
#        --encrypted-regex '^(data|stringData)$' \
#        ghcr-sync-credentials.yaml > ghcr-sync-credentials.enc.yaml
#   shred -u ghcr-sync-credentials.yaml
#
# Zot mountet dieses Secret als File /ghcr-credentials/credentials.json
# (siehe values-override.yaml -> extensions.sync.credentialsFile)
apiVersion: v1
kind: Secret
metadata:
  name: registry-ghcr-sync-credentials
  namespace: registry
  labels:
    app.kubernetes.io/name: zot
    app.kubernetes.io/component: sync
    app.kubernetes.io/part-of: infrastructure
    app.kubernetes.io/managed-by: argocd
type: Opaque
stringData:
  # Zot sync credentialsFile-Format: JSON Map mit Upstream-URL als Key
  credentials.json: |
    {
      "ghcr.io": {
        "username": "dhenkeeneg",
        "password": "HIER_GITHUB_PAT_TOKEN_EINTRAGEN"
      },
      "registry-1.docker.io": {
        "username": "HIER_DOCKERHUB_USERNAME_EINTRAGEN",
        "password": "HIER_DOCKERHUB_ACCESS_TOKEN_EINTRAGEN"
      }
    }
