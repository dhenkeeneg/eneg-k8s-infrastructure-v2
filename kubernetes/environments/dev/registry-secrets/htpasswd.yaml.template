---
# VORLAGE - NICHT COMMITTEN (nur als .enc.yaml committen)!
# Zot Registry htpasswd Secret (DEV) - zwei User fuer Phase 9a
#
# Phase 9a Etappe A (21.04.2026): User 'eneg' (Push-Auth)
# Phase 9a Etappe B (23.04.2026): User 'zot-sync-prod' (read-only fuer PROD-Zot-Sync)
#
# accessControl in values-override.yaml ist unveraendert:
#   - eneg:          read+create+update+delete  (policy)
#   - zot-sync-prod: read                        (defaultPolicy, greift automatisch)
#   - anonymous:     read                        (anonymousPolicy)
#
# ========================================
# WORKFLOW auf k8s-mgmt-10 (mit 3 Verifikations-Gates):
# ========================================
#
# 1. Bestehenden eneg-Hash aus der verschluesselten Datei extrahieren:
#      cd ~/git/eneg-k8s-infrastructure-v2/kubernetes/environments/dev/registry-secrets
#      ENEG_FULL=$(sops --decrypt htpasswd.enc.yaml \
#                  | grep -E '^\s*htpasswd:' \
#                  | sed 's/^[[:space:]]*htpasswd:[[:space:]]*//' \
#                  | tr -d '"')
#      ENEG_HASH="${ENEG_FULL#eneg:}"
#      echo "eneg hash (gekuerzt): ${ENEG_HASH:0:20}..."
#
# 2. Neuen Hash fuer zot-sync-prod generieren (Passwort MERKEN fuer Commit 2):
#      htpasswd -nBC 10 zot-sync-prod
#      # Ausgabe: "zot-sync-prod:$2y$10$XXXX..."
#      # NUR den Teil NACH "zot-sync-prod:" kopieren und in ZOT_SYNC_HASH setzen:
#      ZOT_SYNC_HASH='$2y$10$XXXXXHIERHASHEINFUEGENXXXXX'
#      #             ^                                  ^
#      #             single quotes (!) damit Bash das $ nicht als Variable interpretiert
#
# 3. Vorlage aus dieser .template-Datei ohne Kopfkommentar nach /tmp/ kopieren:
#      grep -v '^#' htpasswd.yaml.template | sed '/^$/d' > /tmp/htpasswd-work.yaml
#      # oder einfach manuell: die 15 Zeilen unten copy-pasten
#
# 4. Platzhalter ersetzen (sed mit | als Delimiter, da bcrypt / enthaelt):
#      sed -i "s|REPLACE_HASH_ENEG|${ENEG_HASH}|" /tmp/htpasswd-work.yaml
#      sed -i "s|REPLACE_HASH_ZOT_SYNC_PROD|${ZOT_SYNC_HASH}|" /tmp/htpasswd-work.yaml
#      cat /tmp/htpasswd-work.yaml  # SICHTPRUEFUNG
#
# 5. Verschluesseln in temp-File (NICHT direkt nach htpasswd.enc.yaml!):
#      sops --encrypt \
#           --age age1fdqtcha9jnzqafe5t6hed6v5sv858x2tt6nwuw00u3luyxuaqcxqh5mcrm \
#           --encrypted-regex '^(data|stringData)$' \
#           /tmp/htpasswd-work.yaml > /tmp/htpasswd-encrypted.yaml
#
# 6. DREI VERIFIKATIONS-GATES (alle muessen OK sein):
#      [ -s /tmp/htpasswd-encrypted.yaml ] \
#        && echo "Gate 1 OK: nicht leer" \
#        || echo "Gate 1 FAIL: Datei leer!"
#      grep -q "^sops:" /tmp/htpasswd-encrypted.yaml \
#        && echo "Gate 2 OK: sops-Block vorhanden" \
#        || echo "Gate 2 FAIL: kein sops-Block!"
#      COUNT=$(sops --decrypt /tmp/htpasswd-encrypted.yaml \
#              | grep -cE "^\s*(eneg|zot-sync-prod):")
#      [ "$COUNT" -eq 2 ] \
#        && echo "Gate 3 OK: 2 User entschluesselbar" \
#        || echo "Gate 3 FAIL: $COUNT statt 2"
#
# 7. Nur wenn ALLE 3 Gates OK: umbenennen und Cleanup
#      mv /tmp/htpasswd-encrypted.yaml htpasswd.enc.yaml
#      shred -u /tmp/htpasswd-work.yaml
#
# 8. Commit + Push (siehe Commit-Anweisung im Chat)
#
# ========================================
# YAML-Struktur (copy-paste fuer Schritt 3 falls manuell):
# ========================================
apiVersion: v1
kind: Secret
metadata:
  name: registry-htpasswd
  namespace: registry
  labels:
    app.kubernetes.io/name: zot
    app.kubernetes.io/component: registry
    app.kubernetes.io/part-of: infrastructure
    app.kubernetes.io/managed-by: argocd
type: Opaque
stringData:
  htpasswd: |
    eneg:REPLACE_HASH_ENEG
    zot-sync-prod:REPLACE_HASH_ZOT_SYNC_PROD
