---
# VORLAGE - NICHT COMMITTEN!
# Zot Registry htpasswd Secret (DEV) - User 'eneg' fuer Push-Auth
#
# Phase 9a - Etappe A (Container Registry Infrastruktur)
#
# 1. bcrypt-Hash auf k8s-mgmt-10 erzeugen (interaktive Passwort-Eingabe, NICHT in Shell-History):
#      htpasswd -nBC 10 eneg
#      # Eingabeaufforderung: Passwort zwei Mal eintippen
#      # Ausgabe hat Format: eneg:$2y$10$abcdefghijklmnopqrstuvwxyz...
#
#    Alternative (falls htpasswd nicht installiert ist):
#      apt-get install apache2-utils       # auf Debian/Ubuntu
#      # oder
#      dnf install httpd-tools             # auf RHEL/Rocky
#
# 2. Ausgabe unten bei 'htpasswd:' eintragen (gesamte Zeile 'eneg:$2y$10$...').
#    Nur den Teil NACH dem Doppelpunkt mit dem 'eneg:' Prefix einfuegen.
#
# 3. Verschluesseln auf k8s-mgmt-10:
#      cd ~/git/eneg-k8s-infrastructure-v2/kubernetes/environments/dev/registry-secrets
#      sops --encrypt --age age1fdqtcha9jnzqafe5t6hed6v5sv858x2tt6nwuw00u3luyxuaqcxqh5mcrm \
#           --encrypted-regex '^(data|stringData)$' \
#           htpasswd.yaml.template > htpasswd.enc.yaml
#
# 4. Diese Vorlage NICHT committen, nur .enc.yaml committen
#
# Zot mountet dieses Secret ueber secretMounts als /secret/htpasswd
# (siehe kubernetes/environments/dev/registry/values-override.yaml)
apiVersion: v1
kind: Secret
metadata:
  name: registry-htpasswd
  namespace: registry
  labels:
    app.kubernetes.io/name: zot
    app.kubernetes.io/component: registry
    app.kubernetes.io/part-of: infrastructure
    app.kubernetes.io/managed-by: argocd
type: Opaque
stringData:
  htpasswd: "eneg:HIER_BCRYPT_HASH_EINTRAGEN"
