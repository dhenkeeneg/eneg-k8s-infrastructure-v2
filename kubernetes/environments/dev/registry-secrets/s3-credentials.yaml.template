---
# VORLAGE - NICHT COMMITTEN!
# Zot Registry S3 Credentials fuer NAS10 Bucket k8s-dev-registry (DEV)
#
# Phase 9a - Etappe A (Container Registry Infrastruktur)
#
# 1. Werte unten eintragen (NAS10 Access Key + Secret Key fuer Bucket k8s-dev-registry)
#
# 2. Verschluesseln auf k8s-mgmt-10:
#      cd ~/git/eneg-k8s-infrastructure-v2/kubernetes/environments/dev/registry-secrets
#      sops --encrypt --age age1fdqtcha9jnzqafe5t6hed6v5sv858x2tt6nwuw00u3luyxuaqcxqh5mcrm \
#           --encrypted-regex '^(data|stringData)$' \
#           s3-credentials.yaml.template > s3-credentials.enc.yaml
#
# 3. Diese Vorlage NICHT committen, nur .enc.yaml committen
#
# Keys werden von Zot ueber `extraEnv` als S3_ACCESS_KEY / S3_SECRET_KEY gelesen
# (siehe kubernetes/environments/dev/registry/values-override.yaml)
apiVersion: v1
kind: Secret
metadata:
  name: registry-s3-credentials
  namespace: registry
  labels:
    app.kubernetes.io/name: zot
    app.kubernetes.io/component: registry
    app.kubernetes.io/part-of: infrastructure
    app.kubernetes.io/managed-by: argocd
type: Opaque
stringData:
  accesskey: HIER_NAS10_ACCESS_KEY_EINTRAGEN
  secretkey: HIER_NAS10_SECRET_KEY_EINTRAGEN
